# ─────────────────────────────────────────────
#  Genesys Cloud Auth Token Service — Environment Variables
# ─────────────────────────────────────────────
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets to source control.
#
# All three variables are REQUIRED for the service to operate.
# ─────────────────────────────────────────────

# Secret key that callers must supply via the x-api-key header.
# Generate a strong random value: openssl rand -hex 32
INTERNAL_API_KEY=

# Genesys Cloud / Microsoft Entra ID SSO credentials.
# These act as the fallback when no credentials are sent in the POST body.
GENESIS_USER_EMAIL=
GENESIS_USER_PASSWORD=
